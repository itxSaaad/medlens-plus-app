{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "entrypoint": "src.api.main:app",
      "framework": "fastapi"
    },
    "web": {
      "buildCommand": "pnpm --filter @medlens/web build",
      "root": "apps/web",
      "installCommand": "pnpm install --frozen-lockfile",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
