{
  "name": "@medlens/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@medlens/ui-tokens": "workspace:*",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.7",
    "react-native-css-interop": "0.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "4.28.0",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^9.39.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No mobile tests configured yet\"",
    "build": "expo export --platform web --output-dir dist",
    "prebuild": "expo prebuild --clean",
    "ios:release": "expo run:ios --configuration Release",
    "android:release": "expo run:android --variant release",
    "build:ios:local": "npx eas-cli build --platform ios --local --profile production",
    "build:android:local": "npx eas-cli build --platform android --local --profile production"
  },
  "private": true
}
