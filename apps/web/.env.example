# Server only — never prefix with NEXT_PUBLIC_
# Waitlist signups live in Upstash Redis (free tier) until Supabase is wired
# up — create a free database at https://console.upstash.com and paste its
# REST URL/token here. Values below are dev-only placeholders and will fail
# loudly (500s) if used against a real deploy.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=dev-token
# Generate a long random string for admin access to /admin/waitlist
WAITLIST_ADMIN_API_KEY=1234567890
